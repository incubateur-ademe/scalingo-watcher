{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "pull-request-header": "Cette pull request prépare la prochaine release. La fusionner crée le tag et la release GitHub, puis déplace le tag majeur.",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Nouveautés"
    },
    {
      "type": "fix",
      "section": "Corrections"
    },
    {
      "type": "perf",
      "section": "Performances"
    },
    {
      "type": "revert",
      "section": "Retours en arrière"
    },
    {
      "type": "deps",
      "section": "Dépendances"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Refactorisation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Construction",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Intégration continue",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "generic",
          "path": "template/.github/workflows/apply.yml"
        },
        {
          "type": "generic",
          "path": "template/.github/workflows/propose-db.yml"
        },
        {
          "type": "generic",
          "path": "template/.github/workflows/reconcile.yml"
        },
        {
          "type": "generic",
          "path": "template/.github/workflows/validate.yml"
        },
        {
          "type": "generic",
          "path": "template/manifest.yaml"
        },
        {
          "type": "generic",
          "path": "template/renovate.json5"
        },
        {
          "type": "generic",
          "path": "template/README.md"
        }
      ]
    }
  }
}
